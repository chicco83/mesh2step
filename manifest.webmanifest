{
  "name": "Mesh2STEP",
  "short_name": "Mesh2STEP",
  "description": "Mesh STL/OBJ/3MF -> STEP con superfici CAD reali, offline nel browser",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#101214",
  "theme_color": "#101214",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "model/stl": [".stl"], "model/obj": [".obj"], "model/3mf": [".3mf"] } }
  ]
}
